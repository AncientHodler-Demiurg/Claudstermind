{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "StoicSyntax Pact",
  "scopeName": "source.pact.stoic",
  "fileTypes": ["pact", "repl"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#defs" },
    { "include": "#bands" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#accessor" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.section.stoic", "match": ";;.*$" },
        { "name": "comment.line.semicolon.pact", "match": ";.*$" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.pact",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "name": "constant.character.escape.pact", "match": "\\\\." }]
    },
    "numbers": {
      "name": "constant.numeric.pact",
      "match": "(?<![\\w.-])-?\\d+(\\.\\d+)?"
    },
    "defs": {
      "comment": "Def-forms per the Pact 5 lexer (LexUtils.hs). No defproperty — the property system was removed in Pact 5.",
      "name": "storage.type.def.pact",
      "match": "\\b(module|interface|defun|defcap|defconst|defschema|deftable|defpact)\\b"
    },
    "keywords": {
      "comment": "Pact 5 builtins + special forms, SOURCED from kadena-io/pact-5 Pact/Core/Builtin.hs (not the docs). Boundaries exclude identifier/qualifier chars so a keyword never matches inside a qualified or StoicSyntax name.",
      "name": "keyword.control.pact",
      "match": "(?<![\\w?<>|.:\\-])(let\\*?|lambda|bind|cond|if|and\\?|or\\?|and|or|not|enforce-pact-version-range|enforce-pact-version|enforce-guard|enforce-keyset|enforce-verifier|enforce-one|enforce|with-capability|with-default-read|with-read|step-with-rollback|step|use|implements|bless|abs|acquire-module-admin|add-time|at|base64-decode|base64-encode|begin-named-tx|begin-tx|ceiling-prec|ceiling|chain-data|commit-tx|compose-capability|compose|concat|contains|continue-pact-rollback-yield-object|continue-pact-rollback-yield|continue-pact-with-rollback|continue-pact|continue|create-capability-pact-guard|create-capability-guard|create-module-guard|create-pact-guard|create-principal|create-table|days|dec|define-read-keyset|define-keyset|define-namespace|describe-keyset|describe-module|describe-namespace|describe-table|diff-time|distinct|drop|emit-event|enumerate-step|enumerate|env-ask-gasmodel|env-chain-data|env-data|env-enable-repl-natives|env-events|env-exec-config|env-gaslimit|env-gaslog|env-gasmodel|env-gas|env-hash|env-keys|env-milligas|env-module-admin|env-namespace-policy|env-set-debug-flag|env-set-gas|env-set-milligas|env-sigs|env-stackframe|env-verifiers|exp|expect-failure-match|expect-failure|expect-that|expect|filter|floor-prec|floor|fold-db|fold|format-time|format|hash-keccak256|hash-poseidon|hash|hours|hyperlane-decode-token-message|hyperlane-encode-token-message|hyperlane-message-id|identity|insert|install-capability|int-to-str|is-charset|is-principal|keys|keyset-ref-guard|length|list-modules|ln|load-with-env|load|log|make-list|map|minutes|mod|namespace|negate|pact-id|pact-state|pact-version|pairing-check|parse-time|point-add|poseidon-hash-hack-a-chain|print|read-decimal|read-integer|read-keyset|read-msg-default|read-msg|read-string|read-with-fields|read|remove|require-capability|reset-pact-state|resume|reverse|rollback-tx|round-prec|round|scalar-mult|select-with-fields|select|shift|show|sig-keyset|sort-object|sort|sqrt|static-redeploy|str-to-int-base|str-to-int|str-to-list|take|test-capability|time|tx-hash|typecheck|typeof-principal|typeof|update|validate-principal|verify-spv|where|with-default-read|with-read|write|xor|yield-to-chain|yield|zip)(?![\\w?<>|.:\\-])"
    },
    "types": {
      "name": "entity.name.type.pact",
      "match": "(?<=:)[A-Za-z][\\w.-]*"
    },
    "accessor": {
      "name": "punctuation.accessor.pact",
      "match": "::"
    },
    "bands": {
      "comment": "StoicSyntax prefix bands — the prefix is the contract. A lazy qualifier group lets a prefix be recognized after a module/band segment (IC|UDC_, URC|KDA-PID_CLAD) or a cap-arrow (SWP|A_, SWP|C>). Cool = unprotected, warm/red = protected.",
      "patterns": [
        { "match": "(?<![\\w|.>-])((?:[\\w-]+[|.])*?)((?:WI|WU|WW|W)[_>][\\w|<>.-]*)", "captures": { "1": { "name": "punctuation.namespace.stoic" }, "2": { "name": "stoic.band.write" } } },
        { "match": "(?<![\\w|.>-])((?:[\\w-]+[|.])*?)(A[_>][\\w|<>.-]*)", "captures": { "1": { "name": "punctuation.namespace.stoic" }, "2": { "name": "stoic.band.admin" } } },
        { "match": "(?<![\\w|.>-])((?:[\\w-]+[|.])*?)((?:XI|XE|XB)[_>][\\w|<>.-]*)", "captures": { "1": { "name": "punctuation.namespace.stoic" }, "2": { "name": "stoic.band.orch" } } },
        { "match": "(?<![\\w|.>-])((?:[\\w-]+[|.])*?)(CAP[_>|][\\w|<>.-]*)", "captures": { "1": { "name": "punctuation.namespace.stoic" }, "2": { "name": "stoic.band.cap" } } },
        { "match": "(?<![\\w|.>-])((?:[\\w-]+[|.])*?)(C[_>][\\w|<>.-]*)", "captures": { "1": { "name": "punctuation.namespace.stoic" }, "2": { "name": "stoic.band.client" } } },
        { "match": "(?<![\\w|.>-])((?:[\\w-]+[|.])*?)(UEV[_>|][\\w|<>.-]*)", "captures": { "1": { "name": "punctuation.namespace.stoic" }, "2": { "name": "stoic.band.enforce" } } },
        { "match": "(?<![\\w|.>-])((?:[\\w-]+[|.])*?)(UDC[_>|][\\w|<>.-]*)", "captures": { "1": { "name": "punctuation.namespace.stoic" }, "2": { "name": "stoic.band.ctor" } } },
        { "match": "(?<![\\w|.>-])((?:[\\w-]+[|.])*?)((?:URDC|URD|URC|UR)[_>|][\\w|<>.-]*)", "captures": { "1": { "name": "punctuation.namespace.stoic" }, "2": { "name": "stoic.band.read" } } },
        { "match": "(?<![\\w|.>-])((?:[\\w-]+[|.])*?)((?:UCK|UC)[_>|][\\w|<>.-]*)", "captures": { "1": { "name": "punctuation.namespace.stoic" }, "2": { "name": "stoic.band.compute" } } }
      ]
    }
  }
}
