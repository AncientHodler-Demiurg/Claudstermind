# DMP reverse tunnel (WebSocket) — copy to /home/ancientbox/ClaudeWS/.secrets/dmp-tunnel.env and fill in.
# NOT committed anywhere real (carries the shared secret). Read by deploy/dmp-tunnel.service.
#
# dmp-remote's WS endpoint on the VPS that the bridge dials OUT to (AncientIntel initiates the connection,
# so no inbound port is opened at home). Path must match dmp-remote's attachReverseTunnel({ path }).
DMP_TUNNEL_URL=wss://demiourgos.ancientholdings.eu/dmp-agent
#
# Shared secret — MUST byte-match dmp-remote's DMP_TUNNEL_SECRET (the VPS remote.env). Long random string, >= 16 chars.
DMP_TUNNEL_SECRET=
#
# Local dmp-main to relay to (default; rarely changed).
DMP_TUNNEL_TARGET=http://127.0.0.1:4002
