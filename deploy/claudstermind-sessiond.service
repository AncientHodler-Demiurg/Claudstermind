[Unit]
Description=Claudstermind session daemon (owns the agent engine; survives web deploys)
Documentation=file:///home/ancientbox/ClaudeWS/Claudstermind/HANDOFF-SESSIOND.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ancientbox
WorkingDirectory=/home/ancientbox/ClaudeWS/Claudstermind
# systemd creates /run/claudstermind (owned by User above, mode 0750) before ExecStart and removes
# it on stop — so the unix socket lives in a per-service runtime dir the daemon can write to even as
# a non-root user, without a stale socket surviving a crash. SESSIOND_SOCK points sessiond at it;
# the same value must be set for the web process (Wave 2) so it dials the same socket.
RuntimeDirectory=claudstermind
RuntimeDirectoryMode=0750
Environment=SESSIOND_SOCK=/run/claudstermind/sessiond.sock
# Default model for every session when the client sends no explicit pick ("Default" in the selector). The
# engine reads this (WorkspaceManager `model: … ?? process.env.CLAUDE_WORKSPACE_MODEL`); the SessiondClient
# forwards no model, so THIS is the only place a default reaches sessiond — setting it on the web service
# does nothing for the sessiond engine. Comment out to fall back to the Claude CLI's own default.
Environment=CLAUDE_WORKSPACE_MODEL=opus
# OmniRoute integration (optional): OMNIROUTE_KEY + OMNIROUTE_URL. When set, the model selector offers
# "omni/…" models that route THIS session through the local OmniRoute gateway (free/other models) instead of
# Anthropic. Kept in .secrets (not inline) so the key isn't baked into the unit. The leading `-` makes it
# optional — the service still starts if the file is absent. Remove the line to disable the feature entirely.
EnvironmentFile=-/home/ancientbox/ClaudeWS/.secrets/omniroute.env
ExecStart=/usr/bin/node sessiond/sessiond.mjs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
